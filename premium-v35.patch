+
+void App::LayoutPremiumControls() {
+    if(!control_||!targetCombo_)return;
+    RECT bounds{};GetClientRect(control_,&bounds);
+    const float scale=std::min(float(bounds.right)/premium::kDesignWidth,
+                               float(bounds.bottom)/premium::kDesignHeight);
+    const auto put=[&](int id,premium::HitRect rect,int popupExtra=0){
+        if(HWND ctl=GetDlgItem(control_,id))
+            SetWindowPos(ctl,nullptr,int(rect.x*scale),int(rect.y*scale),
+                int(rect.w*scale),int((rect.h+popupExtra)*scale),SWP_NOZORDER|SWP_NOACTIVATE);
+    };
+    put(IDC_TARGET,premium::kTarget,280);
+    put(IDC_DYNAMIC_TARGET,premium::kTargetFps);
+    put(IDC_CROSSHAIR_RADIUS,premium::kRadius);
+    put(IDC_CROSSHAIR_FEATHER,premium::kFeather);
+}
+
+void App::DrawPremiumUI(HDC hdc) {
+    RECT r{};GetClientRect(control_,&r);
+    wchar_t status[260]{};
+    if(status_)GetWindowTextW(status_,status,260);
+    const int backend=int(SendDlgItemMessageW(control_,IDC_CAPTURE_BACKEND,CB_GETCURSEL,0,0));
+    const int multiplier=int(SendDlgItemMessageW(control_,IDC_MULTIPLIER,CB_GETCURSEL,0,0));
+    const int res=int(SendDlgItemMessageW(control_,IDC_NVOF_RESOLUTION,CB_GETCURSEL,0,0));
+    premium::Paint(hdc,r.right,r.bottom,std::clamp(backend,0,1),std::clamp(multiplier,0,6),
+                   std::clamp(res,0,2),running_,multiplier==6,status,hover_);
+}
+
+void App::RequestStop() {
+    if(!running_)return;
+    stop_=true;
+    if(workerControlEvent_)SetEvent(workerControlEvent_);
+    if(HWND stop=GetDlgItem(control_,IDC_STOP))EnableWindow(stop,FALSE);
+    if(status_)SetWindowTextW(status_,L"Stopping capture... the control panel stays open.");
+    InvalidateRect(control_,nullptr,FALSE);
+}
+
+bool App::PremiumHit(float x,float y) {
+    if(premium::kRefresh.Contains(x,y)){
+        if(!running_)RefreshTargets();return true;
+    }
+    if(premium::kStart.Contains(x,y)){
+        if(!running_)Start();InvalidateRect(control_,nullptr,FALSE);return true;
+    }
+    if(premium::kStop.Contains(x,y)){
+        if(running_)RequestStop();return true;
+    }
+    if(running_)return false;
+    const auto change=[&](int controlId,int selection){
+        SendDlgItemMessageW(control_,controlId,CB_SETCURSEL,selection,0);
+        InvalidateRect(control_,nullptr,FALSE);
+    };
+    if(premium::kCapture.Contains(x,y)) {
+        const int value=std::clamp(int((x-premium::kCapture.x)*2/premium::kCapture.w),0,1);
+        change(IDC_CAPTURE_BACKEND,value);return true;
+    }
+    if(premium::kFactor.Contains(x,y)){
+        const int button=std::clamp(int((x-premium::kFactor.x)*7/premium::kFactor.w),0,6);
+        static constexpr int kIndices[]={0,6,1,2,3,4,5};
+        change(IDC_MULTIPLIER,kIndices[button]);
+        EnableWindow(GetDlgItem(control_,IDC_DYNAMIC_TARGET),button==1);
+        InvalidateRect(control_,nullptr,FALSE);return true;
+    }
+    if(premium::kResolution.Contains(x,y)){
+        const int value=std::clamp(int((x-premium::kResolution.x)*3/premium::kResolution.w),0,2);
+        change(IDC_NVOF_RESOLUTION,value);return true;
+    }
+    return false;
 }
 
