+  SolidBrush b(fill);g.FillPath(&b,&path);
+  if(outline.GetA()) {Pen p(outline,line);g.DrawPath(&p,&path);}
+}
+inline void GradRounded(Graphics& g, RectF r, float rad, Color hi, Color lo, Color outline=C(0,0,0,0)){
