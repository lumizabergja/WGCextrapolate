+bool App::PresentPrediction(Dx12State& d, UINT sourceSlot, float fraction) {
+    const UINT allocatorIndex=d.nextAllocator++ % kAllocatorCount;
+    const UINT64 previous=d.allocatorFenceValues[allocatorIndex];
+    if(previous && d.frameFence->GetCompletedValue()<previous) {
+        HR(d.frameFence->SetEventOnCompletion(previous,d.frameEvent),"Prediction allocator fence");
+        if(WaitForSingleObject(d.frameEvent,3000)!=WAIT_OBJECT_0) return false;
+    }
+    ConsumeGpuProfile(d,allocatorIndex);
+    HR(d.allocators[allocatorIndex]->Reset(),"Prediction reset allocator");
+    HR(d.list->Reset(d.allocators[allocatorIndex].Get(),d.pipeline.Get()),"Prediction reset list");
+    UpdateFrameSRVs(d,allocatorIndex,sourceSlot);
+    ID3D12Resource* source=d.sharedTextures[sourceSlot].Get();
+    ID3D12Resource* motion=gDLSS.MotionTexture();
+    const UINT frame=d.swapchain->GetCurrentBackBufferIndex();
+    Transition(d.list.Get(),source,D3D12_RESOURCE_STATE_COMMON,D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    Transition(d.list.Get(),motion,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    Transition(d.list.Get(),d.backBuffers[frame].Get(),D3D12_RESOURCE_STATE_PRESENT,D3D12_RESOURCE_STATE_RENDER_TARGET);
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv=d.rtvHeap->GetCPUDescriptorHandleForHeapStart();
+    rtv.ptr+=SIZE_T(frame)*d.rtvStride;
+    d.list->OMSetRenderTargets(1,&rtv,FALSE,nullptr);
+    D3D12_VIEWPORT vp{0,0,float(d.width),float(d.height),0,1};
+    D3D12_RECT scissor{0,0,LONG(d.width),LONG(d.height)};
+    d.list->RSSetViewports(1,&vp); d.list->RSSetScissorRects(1,&scissor);
+    d.list->SetGraphicsRootSignature(d.rootSignature.Get());
+    ID3D12DescriptorHeap* heaps[]={d.srvHeap.Get()};d.list->SetDescriptorHeaps(1,heaps);
+    auto table=d.srvHeap->GetGPUDescriptorHandleForHeapStart();
+    table.ptr+=SIZE_T(allocatorIndex*2u)*d.srvStride;
+    d.list->SetGraphicsRootDescriptorTable(0,table);
+    float params[]={fraction,float(d.sourceWidth),float(d.sourceHeight)};
+    d.list->SetGraphicsRoot32BitConstants(1,3,params,0);
+    d.list->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    d.list->DrawInstanced(3,1,0,0);
+    Transition(d.list.Get(),motion,D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    Transition(d.list.Get(),source,D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,D3D12_RESOURCE_STATE_COMMON);
+    Transition(d.list.Get(),d.backBuffers[frame].Get(),D3D12_RESOURCE_STATE_RENDER_TARGET,D3D12_RESOURCE_STATE_PRESENT);
+    HR(d.list->Close(),"Prediction close list");
+    ID3D12CommandList* lists[]={d.list.Get()}; d.queue->ExecuteCommandLists(1,lists);
+    const UINT64 fenceValue=d.nextAllocatorFenceValue++;
+    HR(d.queue->Signal(d.frameFence.Get(),fenceValue),"Prediction signal fence");
+    d.allocatorFenceValues[allocatorIndex]=fenceValue;
+    gDLSS.MarkPredictionInUse(d.frameFence.Get(),fenceValue);
+    const UINT sync=d.allowTearing?0:1;
+    const UINT flags=d.allowTearing?DXGI_PRESENT_ALLOW_TEARING:0;
+    return SUCCEEDED(d.swapchain->Present(sync,flags));
 }
 
