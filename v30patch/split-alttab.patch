+            auto frame = framePool_.TryGetNextFrame();
+            if (!frame) break;
+            try { frame.Close(); } catch (...) {}
+        }
+        if (frameEvent_) ResetEvent(frameEvent_);
+        return true;
+    } catch (winrt::hresult_error const& e) {
+        error = e.message().c_str();
+    } catch (...) {
+        error = L"Unknown WGC drain failure.";
+    }
+    return false;
+#endif
+}
