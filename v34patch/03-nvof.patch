+    if(FAILED(D3DCompile(shader,sizeof(shader)-1,nullptr,nullptr,nullptr,"VS","vs_5_0",D3DCOMPILE_OPTIMIZATION_LEVEL3,0,&vs,&errors))) return false;
+    errors.Reset();
+    if(FAILED(D3DCompile(shader,sizeof(shader)-1,nullptr,nullptr,nullptr,"PS","ps_5_0",D3DCOMPILE_OPTIMIZATION_LEVEL3,0,&ps,&errors))) return false;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd{}; pd.pRootSignature=scaleRoot_.Get();
+    pd.VS={vs->GetBufferPointer(),vs->GetBufferSize()}; pd.PS={ps->GetBufferPointer(),ps->GetBufferSize()};
+    D3D12_RENDER_TARGET_BLEND_DESC blend{}; blend.RenderTargetWriteMask=D3D12_COLOR_WRITE_ENABLE_ALL;
+    for(auto& t:pd.BlendState.RenderTarget)t=blend;
+    pd.SampleMask=UINT_MAX; pd.RasterizerState.FillMode=D3D12_FILL_MODE_SOLID; pd.RasterizerState.CullMode=D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable=TRUE; pd.DepthStencilState.DepthEnable=FALSE; pd.DepthStencilState.StencilEnable=FALSE;
