+
+    static const char shader[] =
+        "Texture2D src:register(t0);SamplerState samp:register(s0);"
+        "struct V{float4 p:SV_Position;float2 uv:TEXCOORD0;};"
+        "V VS(uint id:SV_VertexID){V o;float2 p=float2((id==2)?3.0:-1.0,(id==1)?3.0:-1.0);"
