+bool NvofBridge::EnsureScaled(UINT sourceIndex, ID3D12Fence* captureFence, uint64_t captureValue) {
+    if(!scaledInput_) return true;
+    if(sourceIndex>=3 || !captureFence || !captureValue || !scaleQueue_ || !scaleFence_) return false;
+    if(scaledCaptureValue_[sourceIndex]==captureValue && scaleDoneValue_[sourceIndex]) return true;
+    const uint64_t prior=scaleDoneValue_[sourceIndex];
+    if(prior && scaleFence_->GetCompletedValue()<prior) return false;
+
+    if(FAILED(scaleAllocators_[sourceIndex]->Reset())) return false;
+    auto* list=scaleLists_[sourceIndex].Get();
+    if(FAILED(list->Reset(scaleAllocators_[sourceIndex].Get(),scalePso_.Get()))) return false;
+    D3D12_RESOURCE_BARRIER b{}; b.Type=D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition={sources_[sourceIndex].Get(),D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES,D3D12_RESOURCE_STATE_COMMON,D3D12_RESOURCE_STATE_RENDER_TARGET};
+    list->ResourceBarrier(1,&b);
+    D3D12_VIEWPORT vp{0.0f,0.0f,float(width_),float(height_),0.0f,1.0f};
+    D3D12_RECT sc{0,0,LONG(width_),LONG(height_)};
+    list->RSSetViewports(1,&vp); list->RSSetScissorRects(1,&sc);
+    auto rtv=scaleRtvHeap_->GetCPUDescriptorHandleForHeapStart(); rtv.ptr+=SIZE_T(sourceIndex)*scaleRtvStride_;
+    list->OMSetRenderTargets(1,&rtv,FALSE,nullptr);
+    ID3D12DescriptorHeap* heaps[]={scaleSrvHeap_.Get()}; list->SetDescriptorHeaps(1,heaps);
+    list->SetGraphicsRootSignature(scaleRoot_.Get());
+    auto gpu=scaleSrvHeap_->GetGPUDescriptorHandleForHeapStart(); gpu.ptr+=SIZE_T(sourceIndex)*scaleSrvStride_;
+    list->SetGraphicsRootDescriptorTable(0,gpu);
+    list->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    list->DrawInstanced(3,1,0,0);
+    std::swap(b.Transition.StateBefore,b.Transition.StateAfter);
+    list->ResourceBarrier(1,&b);
+    if(FAILED(list->Close())) return false;
+    if(FAILED(scaleQueue_->Wait(captureFence,captureValue))) return false;
+    ID3D12CommandList* lists[]={list}; scaleQueue_->ExecuteCommandLists(1,lists);
+    const uint64_t done=++scaleValue_;
+    if(FAILED(scaleQueue_->Signal(scaleFence_.Get(),done))) return false;
+    scaleDoneValue_[sourceIndex]=done; scaledCaptureValue_[sourceIndex]=captureValue;
+    return true;
+}
