+bool NvofBridge::InitScaler() {
+    for(UINT i=0;i<3;++i) {
+        if(!captureSources_[i]) return false;
+        const auto desc=captureSources_[i]->GetDesc();
+        if((desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_SIMULTANEOUS_ACCESS)==0) {
+            if(log_) log_(L"OFA resolution scaling requires simultaneous-access capture textures; selected backend/resource does not expose them.");
+            return false;
+        }
+        wchar_t name[64]{};
+        swprintf_s(name,L"NVOFA scaled source %u",i);
+        sources_[i]=MakeScaleTexture(width_,height_,name);
+        if(!sources_[i]) return false;
+    }
+
+    D3D12_COMMAND_QUEUE_DESC qd{}; qd.Type=D3D12_COMMAND_LIST_TYPE_DIRECT;
+    if(FAILED(device_->CreateCommandQueue(&qd,IID_PPV_ARGS(&scaleQueue_)))) return false;
+    if(FAILED(device_->CreateFence(0,D3D12_FENCE_FLAG_NONE,IID_PPV_ARGS(&scaleFence_)))) return false;
+    for(UINT i=0;i<3;++i) {
+        if(FAILED(device_->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT,IID_PPV_ARGS(&scaleAllocators_[i])))) return false;
+        if(FAILED(device_->CreateCommandList(0,D3D12_COMMAND_LIST_TYPE_DIRECT,scaleAllocators_[i].Get(),nullptr,IID_PPV_ARGS(&scaleLists_[i])))) return false;
+        if(FAILED(scaleLists_[i]->Close())) return false;
+    }
+
+    D3D12_DESCRIPTOR_HEAP_DESC sh{}; sh.Type=D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV; sh.NumDescriptors=3; sh.Flags=D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    if(FAILED(device_->CreateDescriptorHeap(&sh,IID_PPV_ARGS(&scaleSrvHeap_)))) return false;
+    scaleSrvStride_=device_->GetDescriptorHandleIncrementSize(sh.Type);
+    D3D12_DESCRIPTOR_HEAP_DESC rh{}; rh.Type=D3D12_DESCRIPTOR_HEAP_TYPE_RTV; rh.NumDescriptors=3;
+    if(FAILED(device_->CreateDescriptorHeap(&rh,IID_PPV_ARGS(&scaleRtvHeap_)))) return false;
+    scaleRtvStride_=device_->GetDescriptorHandleIncrementSize(rh.Type);
+
+    auto srv=scaleSrvHeap_->GetCPUDescriptorHandleForHeapStart();
+    auto rtv=scaleRtvHeap_->GetCPUDescriptorHandleForHeapStart();
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv{}; sv.Format=DXGI_FORMAT_B8G8R8A8_UNORM;
+    sv.ViewDimension=D3D12_SRV_DIMENSION_TEXTURE2D; sv.Shader4ComponentMapping=D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING; sv.Texture2D.MipLevels=1;
+    for(UINT i=0;i<3;++i) {
+        device_->CreateShaderResourceView(captureSources_[i].Get(),&sv,srv);
+        device_->CreateRenderTargetView(sources_[i].Get(),nullptr,rtv);
+        srv.ptr+=scaleSrvStride_; rtv.ptr+=scaleRtvStride_;
+    }
+
+    D3D12_DESCRIPTOR_RANGE range{}; range.RangeType=D3D12_DESCRIPTOR_RANGE_TYPE_SRV; range.NumDescriptors=1;
+    range.BaseShaderRegister=0; range.OffsetInDescriptorsFromTableStart=D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
+    D3D12_ROOT_PARAMETER param{}; param.ParameterType=D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    param.DescriptorTable.NumDescriptorRanges=1; param.DescriptorTable.pDescriptorRanges=&range; param.ShaderVisibility=D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_STATIC_SAMPLER_DESC sampler{}; sampler.Filter=D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+    sampler.AddressU=sampler.AddressV=sampler.AddressW=D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    sampler.MaxLOD=D3D12_FLOAT32_MAX; sampler.ShaderRegister=0; sampler.ShaderVisibility=D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_ROOT_SIGNATURE_DESC rs{}; rs.NumParameters=1; rs.pParameters=&param; rs.NumStaticSamplers=1; rs.pStaticSamplers=&sampler;
+    rs.Flags=D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT;
+    ComPtr<ID3DBlob> sig,errors;
+    if(FAILED(D3D12SerializeRootSignature(&rs,D3D_ROOT_SIGNATURE_VERSION_1,&sig,&errors))) return false;
